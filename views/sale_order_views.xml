<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_stone_workshop_integration" model="ir.ui.view">
        <field name="name">sale.order.form.stone.workshop.integration</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">120</field>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_stone_workshop_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-industry"
                        invisible="stone_workshop_order_count == 0">
                    <field name="stone_workshop_order_count"
                           widget="statinfo"
                           string="Taller"/>
                </button>
            </xpath>

            <!-- ========================================================= -->
            <!-- Pestaña Taller: duplica las líneas con la configuración de -->
            <!-- taller. El grid principal de Líneas de la orden queda      -->
            <!-- libre de columnas de taller.                               -->
            <!-- ========================================================= -->
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Taller" name="workshop_lines" invisible="state != 'sale'">
                    <field name="order_line" nolabel="1" create="0" delete="0">
                        <list editable="bottom" create="0" delete="0">
                            <field name="display_type" column_invisible="True"/>

                            <field name="product_template_id" string="Producto" readonly="1"/>
                            <field name="product_uom_qty" string="Solicitado" readonly="1"/>

                            <field name="stone_workshop_required"
                                   string="Requiere taller"
                                   widget="boolean_toggle"/>

                            <field name="stone_workshop_base_product_id"
                                   string="Producto origen"
                                   invisible="not stone_workshop_required"/>

                            <field name="stone_workshop_process_id"
                                   string="Proceso taller"
                                   invisible="not stone_workshop_required"/>

                            <field name="stone_workshop_input_selector_anchor"
                                   string="Placas base"
                                   widget="sale_workshop_input_selector"
                                   invisible="not stone_workshop_required"/>

                            <field name="stone_workshop_process_chain_count"
                                   string="# Procesos"
                                   invisible="not stone_workshop_required"
                                   readonly="1"/>

                            <button name="action_open_stone_workshop_process_chain"
                                    type="object"
                                    string="Procesos adicionales"
                                    icon="fa-list-ol"
                                    class="btn-link"
                                    invisible="not stone_workshop_required"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_sale_order_line_workshop_chain_form" model="ir.ui.view">
        <field name="name">sale.order.line.workshop.chain.form</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="Procesos adicionales de taller">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Define la cadena de procesos de taller. El primer proceso consume el
                        <strong>producto origen</strong>; cada proceso adicional consume el producto
                        intermedio que produjo el paso anterior, y el último paso produce el
                        <strong>producto vendido</strong>.
                    </div>

                    <group>
                        <group>
                            <field name="product_id" string="Producto vendido" readonly="1"/>
                            <field name="stone_workshop_base_product_id" string="Producto origen" readonly="1"/>
                        </group>
                        <group>
                            <field name="stone_workshop_process_id" string="Proceso principal" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Procesos adicionales (en orden)"/>
                    <field name="stone_workshop_process_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="process_id"/>
                            <field name="input_product_id"/>
                            <field name="workshop_order_id" readonly="1" optional="show"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Guardar" special="save" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
