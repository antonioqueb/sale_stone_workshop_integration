<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_stone_workshop_integration" model="ir.ui.view">
        <field name="name">sale.order.form.stone.workshop.integration</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">120</field>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_stone_workshop_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-industry"
                        invisible="stone_workshop_order_count == 0">
                    <field name="stone_workshop_order_count"
                           widget="statinfo"
                           string="Taller"/>
                </button>
            </xpath>

            <!-- ========================================================= -->
            <!-- Pestaña Taller: duplica las líneas con la configuración de -->
            <!-- taller. El grid principal de Líneas de la orden queda      -->
            <!-- libre de columnas de taller.                               -->
            <!-- ========================================================= -->
            <xpath expr="//page[@name='order_lines']" position="after">
                <!-- Visible desde la COTIZACIÓN: el proceso/producto base se
                     captura antes de confirmar; la OT nace al confirmar (o al
                     completar los datos si la orden ya está confirmada). -->
                <page string="Taller" name="workshop_lines" invisible="state not in ('draft', 'sent', 'sale')">
                    <field name="order_line" nolabel="1" create="0" delete="0">
                        <list editable="bottom" create="0" delete="0">
                            <field name="display_type" column_invisible="True"/>

                            <field name="product_template_id" string="Producto" readonly="1"/>
                            <field name="product_uom_qty" string="Solicitado" readonly="1"/>

                            <field name="stone_workshop_required"
                                   string="Requiere taller"
                                   widget="boolean_toggle"/>

                            <field name="stone_workshop_base_product_id"
                                   string="Producto origen"
                                   invisible="not stone_workshop_required"/>

                            <field name="stone_workshop_process_id"
                                   string="Proceso taller"
                                   invisible="not stone_workshop_required"/>

                            <field name="stone_workshop_input_selector_anchor"
                                   string="Placas base"
                                   widget="sale_workshop_input_selector"
                                   invisible="not stone_workshop_required"/>

                            <field name="stone_workshop_process_chain_count"
                                   string="Pasos extra"
                                   invisible="not stone_workshop_required"
                                   readonly="1"
                                   optional="show"/>

                            <!-- Botón de celda: solo ícono + tooltip. Un botón
                                 con string dentro de una lista rompe el ancho
                                 de la columna y descuadra el grid. -->
                            <button name="action_open_stone_workshop_process_chain"
                                    type="object"
                                    icon="fa-random"
                                    title="Cadena de procesos de taller"
                                    invisible="not stone_workshop_required"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_sale_order_line_workshop_chain_form" model="ir.ui.view">
        <field name="name">sale.order.line.workshop.chain.form</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="Cadena de procesos de taller">
                <sheet>
                    <div class="oe_title mb-2">
                        <h4 class="mb-0">
                            <i class="fa fa-random me-2 text-muted" title="Cadena de procesos"/>Cadena de procesos de taller
                        </h4>
                        <div class="text-muted small">
                            Así viajará el material: cada paso recibe lo que entregó el anterior
                            y el último paso entrega el <strong>producto vendido</strong>.
                        </div>
                    </div>

                    <!-- Pipeline visual: se actualiza en vivo al editar los pasos. -->
                    <field name="stone_workshop_chain_preview"
                           widget="html"
                           nolabel="1"
                           readonly="1"/>

                    <group>
                        <group string="Línea de venta">
                            <field name="product_id"
                                   string="Producto vendido"
                                   readonly="1"
                                   options="{'no_open': True}"/>
                            <field name="product_uom_qty"
                                   string="Cantidad"
                                   readonly="1"/>
                        </group>
                        <group string="Paso 1 · Principal">
                            <field name="stone_workshop_base_product_id"
                                   string="Recibe (origen)"
                                   readonly="1"
                                   options="{'no_open': True}"/>
                            <field name="stone_workshop_process_id"
                                   string="Proceso"
                                   readonly="1"
                                   options="{'no_open': True}"/>
                        </group>
                    </group>

                    <separator string="Pasos adicionales"/>
                    <div class="text-muted small mb-2">
                        Agrega un paso por cada proceso extra después del principal.
                        En <strong>Recibe</strong> indica el producto intermedio que ese paso toma
                        del anterior; la columna <strong>Entrega</strong> se calcula sola.
                        Arrastra <i class="fa fa-bars" title="Reordenar"/> para reordenar.
                        Los pasos con OT generada quedan bloqueados.
                    </div>
                    <field name="stone_workshop_process_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="process_id"
                                   string="Proceso"
                                   readonly="workshop_order_id"
                                   options="{'no_open': True, 'no_create': True}"/>
                            <field name="input_product_id"
                                   string="Recibe"
                                   readonly="workshop_order_id"
                                   options="{'no_open': True, 'no_create': True}"/>
                            <field name="output_product_display"
                                   string="Entrega"/>
                            <field name="workshop_order_id"
                                   string="OT"
                                   readonly="1"
                                   optional="show"/>
                            <field name="workshop_order_state"
                                   string="Estado OT"
                                   widget="badge"
                                   optional="show"
                                   decoration-info="workshop_order_state == 'draft'"
                                   decoration-warning="workshop_order_state == 'in_workshop'"
                                   decoration-success="workshop_order_state == 'done'"
                                   decoration-danger="workshop_order_state == 'cancel'"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Guardar" special="save" class="btn-primary"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
