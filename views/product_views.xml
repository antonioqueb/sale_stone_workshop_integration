<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_stone_workshop_integration" model="ir.ui.view">
        <field name="name">product.template.form.stone.workshop.integration</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Taller piedra" name="stone_workshop_integration">
                    <group>
                        <group string="Producto final vendido">
                            <field name="stone_workshop_required"/>
                            <field name="stone_workshop_auto_create" invisible="not stone_workshop_required"/>
                            <field name="stone_workshop_trigger" invisible="not stone_workshop_required"/>
                            <field name="stone_workshop_commercial_mode" invisible="not stone_workshop_required"/>
                            <field name="stone_workshop_service_product_id" invisible="not stone_workshop_required or stone_workshop_commercial_mode != 'separate_service'"/>
                        </group>
                        <group string="Transformación interna" invisible="not stone_workshop_required">
                            <field name="stone_workshop_base_product_id" required="stone_workshop_required"/>
                            <field name="stone_workshop_process_id" required="stone_workshop_required"/>
                            <field name="stone_workshop_operation_mode"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not stone_workshop_required">
                        Configura este producto como el <b>producto final que verá el cliente</b>.
                        El producto base se aparta y consume en taller; la entrega final se hace con este producto.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
